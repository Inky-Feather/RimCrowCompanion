<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Build.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)../Build.Local.props')" />
  <PropertyGroup>
    <AssemblyName>RimCrowCompanion</AssemblyName>
    <RootNamespace>RimCrowCompanion</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RimCrowCompanion.Legacy'">
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <BaseIntermediateOutputPath>obj/$(RimWorldVersion)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
